[Unit]
Description=ESP32 to MQTT bridge
# Runs only while the ESP32 is plugged in: dev-esp32.device comes from the udev rule
# (backend/udev/99-esp32.rules). Plugging it in (or booting with it attached) starts the
# bridge; unplugging it stops the bridge.
BindsTo=dev-esp32.device
After=dev-esp32.device mosquitto.service
Wants=mosquitto.service

[Service]
ExecStart=/usr/bin/python3 /home/hydro/hydro/backend/bridge.py
Restart=always
RestartSec=3
User=hydro

[Install]
WantedBy=dev-esp32.device
